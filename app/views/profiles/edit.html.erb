<div class="page-container d-flex flex-column align-items-center">

  <div class="w-100 text-center mb-4">
    <h2 class="font-headline-lg-mobile mb-2">プロフィールを編集する</h2>
    <p class="font-body-md text-secondary mb-0">
      変更したい項目だけ、書き換えてください。
    </p>
  </div>

  <%= form_with model: @user, url: profile_path, local: true, class: "w-100 d-flex flex-column gap-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="alert-box" role="alert">
        <% @user.errors.full_messages.each do |message| %>
          <p class="mb-0"><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="w-100">
      <label for="user_name" class="font-label-lg mb-2 d-block">ニックネーム ※本名は必要ありません</label>
      <%= f.text_field :name,
            id: "user_name",
            class: "form-input-lg",
            value: @user.name %>
    </div>

    <div class="w-100">
      <span class="font-label-lg mb-2 d-block">年代</span>
      <div class="age-select-group">
        <% [["40代以下", 40], ["50代", 50], ["60代", 60], ["70代", 70], ["80代以上", 85]].each do |label, value| %>
          <label class="age-select-btn">
            <%= f.radio_button :age, value, checked: (@user.age == value), class: "age-select-input" %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="w-100">
      <label for="user_email" class="font-label-lg mb-2 d-block">メールアドレス</label>
      <%= f.email_field :email,
            id: "user_email",
            class: "form-input-lg",
            value: @user.email %>
    </div>

    <%= f.submit "この内容で保存する", class: "btn-primary-wide tactile-press" %>
  <% end %>

</div>