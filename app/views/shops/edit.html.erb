<div class="page-container d-flex flex-column align-items-center">

  <div class="w-100 text-center mb-4">
    <h2 class="font-headline-lg-mobile mb-2">店舗情報を編集する</h2>
    <p class="font-body-md text-secondary mb-0">
      変更したい項目だけ、書き換えてください。<br>
      変更が不要な項目は、そのままで大丈夫です。
    </p>
  </div>

  <%= form_with model: @shop, local: true, class: "w-100 d-flex flex-column gap-4" do |f| %>
    <% if @shop.errors.any? %>
      <div class="alert-box" role="alert">
        <% @shop.errors.full_messages.each do |message| %>
          <p class="mb-0"><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <!-- 店舗写真 -->
    <div class="w-100">
      <span class="font-label-lg mb-2 d-block">お店の写真</span>
      <label for="shop_image" class="photo-upload-card">
        <img id="photo-preview-img" class="photo-preview-img" src="<%= @shop.shop_image.url %>" alt="現在のお店の写真">
        <span id="photo-upload-label" class="photo-upload-label">タップして写真を変更する</span>
      </label>
      <%= f.file_field :shop_image,
            id: "shop_image",
            class: "d-none",
            accept: "image/*",
            capture: "environment" %>
    </div>

    <!-- 位置情報 -->
    <div class="w-100">
      <span class="font-label-lg mb-2 d-block">お店の場所</span>
      <button type="button" id="get-location-btn" class="btn-location-action tactile-press">
        <i class="bi bi-geo-alt-fill fs-3"></i>
        <span id="location-btn-label">場所を変更する場合は、お店の前でこのボタンを押してください</span>
      </button>
      <p id="location-status" class="form-hint mt-2 mb-0"></p>
      <%= f.hidden_field :latitude, id: "shop_latitude" %>
      <%= f.hidden_field :longitude, id: "shop_longitude" %>
    </div>

    <!-- 店名 -->
    <div class="w-100">
      <label for="shop_name" class="font-label-lg mb-2 d-block">お店の名前</label>
      <%= f.text_field :name,
            id: "shop_name",
            class: "form-input-lg",
            value: @shop.name %>
    </div>

    <!-- 都道府県 -->
    <div class="w-100">
      <label for="shop_prefecture" class="font-label-lg mb-2 d-block">都道府県</label>
      <%= f.select :prefecture,
            %w[北海道 青森県 岩手県 宮城県 秋田県 山形県 福島県 茨城県 栃木県 群馬県 埼玉県 千葉県 東京都 神奈川県 新潟県 富山県 石川県 福井県 山梨県 長野県 岐阜県 静岡県 愛知県 三重県 滋賀県 京都府 大阪府 兵庫県 奈良県 和歌山県 鳥取県 島根県 岡山県 広島県 山口県 徳島県 香川県 愛媛県 高知県 福岡県 佐賀県 長崎県 熊本県 大分県 宮崎県 鹿児島県 沖縄県],
            { selected: @shop.prefecture },
            { id: "shop_prefecture", class: "form-input-lg" } %>
    </div>

    <!-- 市町村 -->
    <div class="w-100">
      <label for="shop_municipality" class="font-label-lg mb-2 d-block">市町村</label>
      <%= f.text_field :municipality,
            id: "shop_municipality",
            class: "form-input-lg",
            value: @shop.municipality %>
    </div>

    <div class="w-100">
      <label for="shop_kodawari" class="font-label-lg mb-2 d-block">商品へのこだわり</label>
      <%= f.text_area :kodawari,
            id: "shop_kodawari",
            class: "form-input-lg form-textarea",
            rows: 4,
            value: @shop.kodawari %>
    </div>

    <div class="w-100">
      <label for="shop_price" class="font-label-lg mb-2 d-block">価格帯</label>
      <%= f.text_field :price,
            id: "shop_price",
            class: "form-input-lg",
            value: @shop.price %>
    </div>

    <div class="w-100">
      <label for="shop_season" class="font-label-lg mb-2 d-block">販売時期</label>
      <%= f.text_field :season,
            id: "shop_season",
            class: "form-input-lg",
            value: @shop.season %>
    </div>

    <div class="w-100">
      <label for="shop_business_hours" class="font-label-lg mb-2 d-block">営業時間</label>
      <%= f.text_field :business_hours,
            id: "shop_business_hours",
            class: "form-input-lg",
            value: @shop.business_hours %>
    </div>

    <div class="w-100">
      <label for="shop_timing" class="font-label-lg mb-2 d-block">出荷頻度</label>
      <%= f.text_field :timing,
            id: "shop_timing",
            class: "form-input-lg",
            value: @shop.timing %>
    </div>

    <%= f.submit "この内容で保存する", class: "btn-primary-wide tactile-press" %>
  <% end %>
    <%= link_to shop_path(@shop),
        class: "btn-danger-outline tactile-press mt-3",
        data: { turbo_method: :delete, turbo_confirm: "「#{@shop.name}」を削除します。よろしいですか？" } do %>
    <i class="bi bi-trash3 me-2"></i>この店舗を削除する
  <% end %>
</div>