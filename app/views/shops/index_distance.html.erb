<div class="page-container d-flex flex-column align-items-center">

  <div class="w-100 text-center mb-4">
    <h2 class="font-headline-lg-mobile mb-2">近くの直販店を探す</h2>
    <p class="font-body-md text-secondary mb-0">
      現在地から近い順に並んでいます。
    </p>
  </div>

  <% if @distance.present? %>
    <div class="w-100 d-flex flex-column gap-3">
      <% @distance.each do |result, shop| %>
        <div class="shop-list-card">
          <div class="shop-list-image">
            <%= image_tag shop.shop_image.url, alt: "#{shop.name}の外観" %>
          </div>
          <div class="shop-list-body">
            <p class="shop-list-name mb-1"><%= shop.name %></p>
            <p class="shop-list-distance mb-1">
              <i class="bi bi-geo-alt"></i> 現在地から 約<%= result.round(1) %>km
            </p>
            <% latest = shop.posts.order(created_at: :desc).first %>
            <% if latest %>
              <p class="shop-list-latest mb-0 <%= 'is-sold-out' if latest.sold_out %>">
                <% if latest.sold_out %>
                  売り切れました
                <% else %>
                  <%= latest.created_at.strftime("%m/%d %H:%M") %>時点の、出荷あり
                <% end %>
              </p>
            <% else %>
              <p class="shop-list-latest mb-0 is-no-post">
                まだ投稿がありません
              </p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="font-body-md text-secondary text-center">
      まだ登録された直売所がありません。
    </p>
  <% end %>

</div>