<% content_for(:title, '使い方 | 新規投稿') %>
<% prereqs = [
  { num: "①", text: "ログインについて：まだログインしていない場合は、ボタンを押すと先にログイン画面が出ます。ログインが終わると、自動でつづきの画面に進みます。(ログインの仕方は「登録の仕方」の説明書をご覧ください)" },
  { num: "②", text: "お店の登録について：この投稿は、すでに登録したお店にだけできます。まだお店を登録していない場合は、先に「店舗登録の仕方」の説明書を見て、お店を登録してください。" }
] %>

<% steps = [
  {
    title: "トップページの「今日の出荷状況を投稿する」を押します",
    notes: [{ type: :plain, text: "トップページにある、茶色いボタン「今日の出荷状況を投稿する」を押します。" }],
    image: "how_to/post/registration/01_top.png",
    caption: "① トップページ(画面をすべて表示しています)"
  },
  {
    title: "投稿するお店を選びます",
    notes: [
      { type: :plain, text: "登録したお店の一覧が出てきます。今日の状況を投稿したいお店を選んで押します。" },
      { type: :note, text: "お店を1つしか登録していない場合も、この画面が出ます。そのお店を押してください。" }
    ],
    image: "how_to/post/registration/02_myshops.png",
    caption: "① お店を選ぶ場所(お店の名前や写真が書かれたカード)"
  },
  {
    title: "「新しく投稿する」を押します",
    notes: [{ type: :plain, text: "選んだお店の、これまでの投稿の一覧が出てきます。いちばん上にある、緑色のボタン「新しく投稿する」を押します。" }],
    image: "how_to/post/registration/03_index.png",
    caption: "① 新しく投稿するボタン"
  },
  {
    title: "「今日の写真」をタップして、写真を選びます",
    notes: [
      { type: :plain, text: "四角い枠の部分をタップすると、カメラで新しく写真を撮るか、すでに撮ってある写真を選ぶか、たずねられます。" },
      { type: :plain, text: "今日、直売所に並べた野菜や果物の写真を選んでください。写真は1枚だけで投稿できます。" }
    ],
    image: "how_to/post/registration/04_photo.png",
    caption: "① 写真を選ぶ場所"
  },
  {
    title: "もっと詳しく書きたい方は(任意)",
    notes: [
      { type: :plain, text: "写真だけでも投稿できます。今日の商品やコメントも書きたい場合は、「さらに詳しく入力する(任意)」を押すと、追加で入力できる項目が出てきます。" },
      { type: :note, text: "急がなくて大丈夫です。写真だけ投稿して、あとから書き足すこともできます。" }
    ],
    image: "how_to/post/registration/05_detail_toggle.png",
    caption: "「さらに詳しく入力する」を押すと開きます"
  },
  {
    title: "開いた項目には、こんなことを書きます(任意)",
    notes: [
      { type: :sub, num: "①", text: "今日の商品：今日出した野菜や果物を、自由に書きます。(例:トマト、きゅうり、なす)" },
      { type: :sub, num: "②", text: "今日の一押し：とくにおすすめしたいものを書きます。(例:採れたて完熟トマト)" },
      { type: :sub, num: "③", text: "コメント：お客さんに伝えたいひとことを書きます。(例:今朝収穫したばかりです)" },
      { type: :sub, num: "④", text: "明日の予定：明日出す予定のものがあれば書きます。(例:明日はピーマンも出す予定です)" },
      { type: :note, text: "すべて入力しなくても大丈夫です。あとから書き直すこともできます。" }
    ],
    image: "how_to/post/registration/06_detail_fields.png",
    caption: "①〜④ それぞれの入力欄"
  },
  {
    title: "「この内容で投稿する」を押します",
    notes: [{ type: :plain, text: "写真(と、書いた場合は詳しい項目)を確認したら、緑色の「この内容で投稿する」を押します。" }],
    image: "how_to/post/registration/07_submit.png",
    caption: "① 投稿するボタン"
  }
] %>

<div class="page-container d-flex flex-column align-items-center">
  <p class="font-body-md text-success fw-bold text-center mb-1">あなたの町の直売所</p>
  <h1 class="font-headline-lg-mobile text-center mb-2">今日の出荷を投稿する仕方</h1>
  <%= link_to "印刷用の文書を表示する", "/how_to/post/3_post_registration.pdf", class: "btn-primary-wide tactile-press mt-4 no-print mb-5", target: "_blank" %>
  <p class="font-body-md text-secondary text-center mb-4">①から順番に、ひとつずつ進めてください。むずかしい操作はありません。</p>

  <div class="alert border border-warning border-2 w-100 mb-4" style="max-width: 640px; background-color:#FDF1E0;">
    <p class="fw-bold mb-2" style="color:#C9791F;">はじめる前に、2つだけ確認してください</p>
    <% prereqs.each do |p| %>
      <p class="mb-2"><span class="fw-bold text-danger me-1"><%= p[:num] %></span><%= p[:text] %></p>
    <% end %>
  </div>

  <% steps.each_with_index do |step, i| %>
    <div class="howto-step border rounded-3 p-3 p-md-4 mb-4 w-100" style="max-width: 640px;">
      <span class="badge bg-success text-white mb-2">STEP <%= i + 1 %></span>
      <h2 class="font-label-lg mb-2"><%= step[:title] %></h2>
      <div class="howto-note bg-light border-start border-4 border-success p-3 mb-3">
        <% step[:notes].each do |n| %>
          <% if n[:type] == :sub %>
            <p class="mb-2"><span class="fw-bold text-danger me-1"><%= n[:num] %></span><%= n[:text] %></p>
          <% elsif n[:type] == :note %>
            <p class="text-secondary small ms-3 mb-0">※<%= n[:text] %></p>
          <% else %>
            <p class="mb-2"><%= n[:text] %></p>
          <% end %>
        <% end %>
      </div>
      <%= image_tag step[:image], class: "img-fluid rounded border", alt: step[:caption] %>
      <p class="text-secondary text-center small fst-italic mt-2 mb-0"><%= step[:caption] %></p>
    </div>
  <% end %>

  <p class="font-label-lg text-success fw-bold text-center mt-3">これで今日の出荷の投稿は完了です!</p>
</div>