<% content_for(:title, '使い方 | ポスター') %>
<div class="page-container d-flex flex-column align-items-center how-to-print">

  <%= link_to how_to_path, class: "how-to-back-link mb-3" do %>
    <i class="bi bi-arrow-left"></i> 使い方の一覧に戻る
  <% end %>

  <div class="w-100 text-center mb-4">
    <h2 class="font-headline-lg-mobile mb-2">お客さんへの伝え方</h2>
    <p class="font-body-md text-secondary mb-0">
      どんなに投稿していても、お客さんが知らなければ意味がありません。<br>
      下のボタンを押すとポスターが印刷できます。お店の目立つ場所に貼って、アプリを使っていることをお客さんに伝えましょう。
    </p>
  </div>

  <!-- ポスター本体 -->
  <%= link_to "印刷用のポスターを表示する", "/how_to/promote/6_promote.pdf", class: "btn-primary-wide tactile-press mt-4 no-print mb-5", target: "_blank" %>
  <%= image_tag "how_to/promote/promote.png", class: "img-fluid mt-4", alt: "お客さんへの伝え方ポスター" %>
</div>