<% content_for(:title, '使い方 | 店舗編集') %>

<% prereqs = [
  { num: "①", text: "ログインについて：まだログインしていない場合は、ボタンを押すと先にログイン画面が出ます。ログインが終わると、自動でつづきの画面に進みます。(ログインの仕方は「登録の仕方」の説明書をご覧ください)" },
  { num: "②", text: "お店の登録について：この操作は、すでに登録したお店にだけできます。まだお店を登録していない場合は、先に「店舗登録の仕方」の説明書を見て、お店を登録してください。" }
] %>

<% steps = [
  {
    title: "画面いちばん下にある「店舗編集」を押します",
    notes: [{ type: :plain, text: "どの画面からでも、いちばん下に4つのボタンが並んでいます。その中の「店舗編集」を押します。" }],
    image: "how_to/shop/edit/01_navbar.png",
    caption: "① 画面いちばん下にある「店舗編集」ボタン"
  },
  {
    title: "編集するお店を選びます",
    notes: [
      { type: :plain, text: "登録したお店の一覧が出てきます。内容を変えたいお店のカードを押します。" },
      { type: :note, text: "お店を1つしか登録していない場合も、この画面が出ます。そのお店を押してください。" }
    ],
    image: "how_to/shop/edit/02_myshops.png",
    caption: "① お店を選ぶ場所(カードの右にあるゴミ箱のマークは、削除に使います)"
  },
  {
    title: "写真や場所を変えたい場合",
    notes: [
      { type: :sub, num: "①", text: "お店の写真を変えたいときは、写真の部分をタップすると、新しい写真を選べます。" },
      { type: :sub, num: "②", text: "お店の場所が変わったときだけ、お店の前で「場所を変更する場合は...」のボタンを押します。" },
      { type: :note, text: "変更したい項目だけ書き換えれば大丈夫です。他の項目は、そのままで構いません。" }
    ],
    image: "how_to/shop/edit/03_photo_location.png",
    caption: "① 写真を変える場所 ② 場所を変更するボタン"
  },
  {
    title: "お店の名前・都道府県・市町村を確認します",
    notes: [{ type: :plain, text: "これまで登録した内容が、あらかじめ入っています。変えたい部分だけ書き直してください。" }],
    image: "how_to/shop/edit/04_name_pref_muni.png",
    caption: "① お店の名前 ② 都道府県 ③ 市町村"
  },
  {
    title: "そのほかの項目も確認します",
    notes: [{ type: :plain, text: "商品へのこだわり・価格帯・販売時期・営業時間・出荷頻度も、これまでの内容が入っています。変えたい部分だけ書き直してください。" }],
    image: "how_to/shop/edit/05_optional_fields.png",
    caption: "①〜⑤ それぞれの入力欄"
  },
  {
    title: "「この内容で保存する」を押します",
    notes: [{ type: :plain, text: "書き直しが終わったら、緑色の「この内容で保存する」を押します。これで変更は完了です。" }],
    image: "how_to/shop/edit/06_save.png",
    caption: "① 保存するボタン"
  },
  {
    danger: true,
    divider_before: {
      heading: "ここまでで、お店の情報の変更は完了です。",
      sub: "ここから先は、お店を「削除」する方法です。削除すると元に戻せないので、よく確認してから進めてください。",
      warning_heading: "お店を削除する前に",
      warning: "お店を削除すると、そのお店の情報と、これまでの投稿もすべて消えてしまいます。あとから元に戻すことはできません。"
    },
    title: "方法①：お店を選ぶ画面から削除する",
    notes: [{ type: :plain, text: "STEP2の画面(編集するお店を選ぶ画面)で、削除したいお店のカードの右にある、ゴミ箱のマークを押します。" }],
    image: "how_to/shop/edit/07_trash_icon.png",
    caption: "① ゴミ箱のマーク(削除ボタン)"
  },
  {
    danger: true,
    title: "方法②：編集する画面からも削除できます",
    notes: [{ type: :plain, text: "STEP6の画面(店舗情報を編集する画面)をいちばん下までスクロールすると、「この店舗を削除する」というリンクがあります。こちらからも削除できます。" }],
    image: "how_to/shop/edit/08_delete_link.png",
    caption: "① この店舗を削除するリンク(編集画面のいちばん下)"
  },
  {
    danger: true,
    title: "確認の画面が出たら、よく読んで選びます",
    notes: [
      { type: :sub, num: "①", text: "「〇〇を削除します。よろしいですか？」という確認が出ます。" },
      { type: :sub, num: "②", text: "やめたいときは「キャンセル」を押します。削除してよければ「OK」を押します。" },
      { type: :note, text: "迷ったときは「キャンセル」を押せば、何も変わりません。安心して押してください。" }
    ],
    image: "how_to/shop/edit/09_confirm_dialog.png",
    caption: "①② 確認の画面(赤い枠がOKボタン)"
  }
] %>

<div class="page-container d-flex flex-column align-items-center">
  <p class="font-body-md text-success fw-bold text-center mb-1">あなたの町の直売所</p>
  <h1 class="font-headline-lg-mobile text-center mb-2">店舗情報を編集・削除する仕方</h1>
  <%= link_to "印刷用の文書を表示する", "/how_to/shop/4_shop_edit.pdf", class: "btn-primary-wide tactile-press mt-4 no-print mb-5", target: "_blank" %>
  <p class="font-body-md text-secondary text-center mb-4">①から順番に、ひとつずつ進めてください。むずかしい操作はありません。</p>

  <div class="alert border border-warning border-2 w-100 mb-4" style="max-width: 640px; background-color:#FDF1E0;">
    <p class="fw-bold mb-2" style="color:#C9791F;">はじめる前に、2つだけ確認してください</p>
    <% prereqs.each do |p| %>
      <p class="mb-2"><span class="fw-bold text-danger me-1"><%= p[:num] %></span><%= p[:text] %></p>
    <% end %>
  </div>

  <% steps.each_with_index do |step, i| %>
    <% if step[:divider_before] %>
      <p class="font-label-lg text-success fw-bold text-center mt-2 mb-1"><%= step[:divider_before][:heading] %></p>
      <p class="text-secondary text-center small mb-4"><%= step[:divider_before][:sub] %></p>
      <div class="alert border border-warning border-2 w-100 mb-4" style="max-width: 640px; background-color:#FDF1E0;">
        <p class="fw-bold mb-2" style="color:#C9791F;"><%= step[:divider_before][:warning_heading] %></p>
        <p class="mb-0"><%= step[:divider_before][:warning] %></p>
      </div>
    <% end %>

    <div class="howto-step border rounded-3 p-3 p-md-4 mb-4 w-100" style="max-width: 640px;">
      <span class="badge <%= step[:danger] ? 'bg-danger' : 'bg-success' %> text-white mb-2">STEP <%= i + 1 %></span>
      <h2 class="font-label-lg mb-2"><%= step[:title] %></h2>
      <div class="howto-note <%= step[:danger] ? '' : 'border-success' %> border-start border-4 p-3 mb-3" style="<%= step[:danger] ? 'background-color:#FDF1E0; border-color:#C9791F !important;' : 'background-color:#EAF2E9;' %>">
        <% step[:notes].each do |n| %>
          <% if n[:type] == :sub %>
            <p class="mb-2"><span class="fw-bold text-danger me-1"><%= n[:num] %></span><%= n[:text] %></p>
          <% elsif n[:type] == :note %>
            <p class="text-secondary small ms-3 mb-0">※<%= n[:text] %></p>
          <% else %>
            <p class="mb-2"><%= n[:text] %></p>
          <% end %>
        <% end %>
      </div>
      <%= image_tag step[:image], class: "img-fluid rounded border", alt: step[:caption] %>
      <p class="text-secondary text-center small fst-italic mt-2 mb-0"><%= step[:caption] %></p>
    </div>
  <% end %>

  <p class="font-label-lg text-success fw-bold text-center mt-3">これで店舗情報の編集・削除は完了です!</p>
</div>