<!-- top.html.erb -->
<div class="page-container d-flex flex-column align-items-center">
  <!-- Hero/Header Image Placeholder -->
  <div class="w-100 hero-image-wrapper shadow-sm mb-4">
    <%= image_tag "top.jpg", alt: "直売所に並ぶ、新鮮な野菜と果物" %>
    <div class="hero-image-overlay"></div>
    <div class="hero-image-text">
      <p class="hero-image-caption">今日は何があるかな、を届けよう</p>
      <p class="hero-image-desc mb-1">
        このアプリは、直売所の「今日の出荷」を写真だけで伝えることができるアプリです。
      </p>
      <p class="hero-image-desc mb-1">
        直売所を営んでいる皆さん、店を登録して、<br>
        今日何を出したかをお客さんに伝えませんか？
      </p>
      <p class="hero-image-desc mb-0">
        お客さんは出荷状況を見て、<br>
        今日の食卓に新鮮な野菜を並べてみませんか？
      </p>
    </div>
  </div>
  <!-- Primary Action Area (Producers) -->
  <div class="w-100 d-flex flex-column gap-3 mb-4">
    <!-- Register Shop Button -->
    <%= link_to new_login_path, class:"w-100 btn-primary-action shadow-sm d-flex align-items-center p-4 gap-4 tactile-press" do %>
      <div class="icon-wrapper p-3 d-flex align-items-center justify-content-center">
        <i class="bi bi-plus-square-dotted" style="font-size: 1rem;"></i>
      </div>
      <div class="d-flex flex-column text-start">
        <span class="font-label-lg mb-1" style="opacity: 0.9;">直売所の方へ</span>
        <span class="font-button-text fs-4">あなたの店舗を登録する</span>
      </div>
    <% end %>

    <!-- Post Inventory Button (High Contrast/Urgency) -->
    <%= link_to new_post_path, class:"w-100 btn-tertiary-action shadow-sm d-flex align-items-center p-4 gap-4 tactile-press" do %>
      <div class="icon-wrapper p-3 d-flex align-items-center justify-content-center">
        <i class="bi bi-truck" style="font-size: 1rem;"></i>
      </div>
      <div class="d-flex flex-column text-start">
        <span class="font-label-lg mb-1" style="opacity: 0.9;">入荷・出荷のお知らせ</span>
        <span class="font-button-text fs-4">今日の出荷状況を投稿する</span>
      </div>
    <% end %>
  </div>

  <!-- Divider -->
  <div class="w-100 custom-divider my-2"></div>

  <!-- Secondary Action Area (Consumers) -->
  <div class="w-100 mt-4">
    <%= link_to shops_path, class:"w-100 btn-search-action shadow-sm d-flex align-items-center justify-content-center gap-3 p-3 tactile-press" do %>
      <i class="bi bi-search fs-2" style="transition: color 0.2s;"></i>
      <span class="font-button-text">近くの直販店を探す</span>
    <% end %>
  </div>
  <!-- About Section -->
  <section class="w-100 about-section">
    <h2 class="about-heading">
      <i class="bi bi-info-circle-fill me-2"></i>「あなたの町の直売所」とは
    </h2>
    <p class="about-body">
      直売所は、新鮮な野菜が並ぶ、地域の宝物です。
      でも「今日、何が出ているか」がわからず、買い物の計画に入れづらいという声があります。
    </p>
    <p class="about-body">
      生産者の方が今日の出荷状況を写真で伝えることで、
      消費者は安心して直売所に立ち寄れるようになります。
      投稿は写真1枚だけでOK。難しい操作は一切ありません。
    </p>
  </section>

  <!-- Recent Posts -->
  <section class="w-100 recent-posts-section">
    <h2 class="recent-posts-heading">
      <i class="bi bi-camera-fill me-2"></i>最近の出荷状況
    </h2>

    <% if @posts.present? %>
      <div class="recent-posts-list">
        <% @posts.each do |post| %>
          <%= link_to shop_path(post.shop), class: "recent-post-card-link" do %>
            <div class="recent-post-card <%= 'is-sold-out' if post.sold_out %>">
              <div class="recent-post-image">
                <% if post.post_images.first %>
                  <%= image_tag post.post_images.first.post_image.url, alt: "#{post.shop.name}の出荷写真" %>
                <% end %>
                <% if post.sold_out %>
                  <span class="recent-post-sold-out-badge">売り切れ</span>
                <% end %>
              </div>
              <div class="recent-post-body">
                <p class="recent-post-shop-name mb-1"><%= post.shop.name %></p>
                <% if post.merchandise.present? %>
                  <p class="recent-post-merchandise mb-1"><%= post.merchandise %></p>
                <% end %>
                <p class="recent-post-time mb-0"><%= post.created_at.strftime("%m/%d %H:%M") %>時点</p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="font-body-md text-secondary text-center">
        まだ投稿がありません。
      </p>
    <% end %>
  </section>

</div>