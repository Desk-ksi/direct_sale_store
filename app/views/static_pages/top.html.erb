<div class="page-container d-flex flex-column align-items-center">
  <!-- Hero/Header Image Placeholder -->
  <div class="w-100 hero-image-wrapper shadow-sm mb-4">
    <img alt="A warm, inviting photo of a rustic wooden vegetable stand filled with fresh, bright green vegetables and colorful fruits. The setting is bathed in soft, natural sunlight, creating a cozy and approachable atmosphere. The color palette emphasizes earthy browns, vibrant harvest greens, and soft beige tones, reflecting a local community market vibe." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDjEpojAIkZfjlGevIrxQeb6wLQ-t6K0Fps1dOmQ9z4HQibtt8HrtRK7sbHbNnZrW35NKTviK4Ua_sYwe-DtsieOp-7OWB8eZxPqpJh5BmfYTvLrZKZVBpXjbg5mEPtLsLfnfIYEdxAULV0mBX4q8wkodnG0INahVSjHqgoicIhi3Yj5TULY3baSEZFrsRaPDrGtknWPMZ32eR0wmhvhjCg4tUX3tR3hVdaAjtvnjCeWOGcfpN6EmGuMw"/>
    <div class="hero-image-overlay"></div>
  </div>

  <!-- Primary Action Area (Producers) -->
  <div class="w-100 d-flex flex-column gap-3 mb-4">
    <!-- Register Shop Button -->
    <button class="w-100 btn-primary-action shadow-sm d-flex align-items-center p-4 gap-4 tactile-press">
      <div class="icon-wrapper p-3 d-flex align-items-center justify-content-center">
        <i class="bi bi-plus-square-dotted" style="font-size: 3rem;"></i>
      </div>
      <div class="d-flex flex-column text-start">
        <span class="font-label-lg mb-1" style="opacity: 0.9;">直売所の方へ</span>
        <span class="font-button-text fs-4">あなたの店舗を登録する</span>
      </div>
    </button>

    <!-- Post Inventory Button (High Contrast/Urgency) -->
    <button class="w-100 btn-tertiary-action shadow-sm d-flex align-items-center p-4 gap-4 tactile-press">
      <div class="icon-wrapper p-3 d-flex align-items-center justify-content-center">
        <i class="bi bi-truck" style="font-size: 3rem;"></i>
      </div>
      <div class="d-flex flex-column text-start">
        <span class="font-label-lg mb-1" style="opacity: 0.9;">入荷・出荷のお知らせ</span>
        <span class="font-button-text fs-4">今日の出荷状況を投稿する</span>
      </div>
    </button>
  </div>

  <!-- Divider -->
  <div class="w-100 custom-divider my-2"></div>

  <!-- Secondary Action Area (Consumers) -->
  <div class="w-100 mt-4">
    <button class="w-100 btn-search-action shadow-sm d-flex align-items-center justify-content-center gap-3 p-3 tactile-press">
      <i class="bi bi-search fs-2" style="transition: color 0.2s;"></i>
      <span class="font-button-text">近くの直販店を探す</span>
    </button>
  </div>
</div>