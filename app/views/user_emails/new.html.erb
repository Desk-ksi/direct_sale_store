<% content_for(:title, 'メールアドレスでの登録画面') %>
<div class="page-container d-flex flex-column align-items-center">
  <div class="w-100 text-center mb-4">
    <h2 class="font-headline-lg-mobile mb-2">メールアドレスで登録する</h2>
    <p class="font-body-md text-secondary mb-0">
      メールアドレスとパスワードを決めて、登録します。
    </p>
  </div>

  <%= form_with model: @user, url: user_emails_path, method: :post, class: "w-100 d-flex flex-column gap-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="alert-box" role="alert">
        <% @user.errors.full_messages.each do |message| %>
          <p class="mb-1"><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="w-100">
      <label for="user_name" class="font-label-lg mb-2 d-block">
        ニックネーム<span class="required-mark">必須</span>
      </label>
      <%= f.text_field :name,
            class: "form-input-lg",
            placeholder: "例：やまだ農園",
            autocomplete: "nickname",
            required: true %>
      <p class="form-hint mt-2 mb-0">
        本名でなくて大丈夫です
      </p>
    </div>

    <div class="w-100">
      <label for="user_email" class="font-label-lg mb-2 d-block">
        メールアドレス<span class="required-mark">必須</span>
      </label>
      <%= f.email_field :email,
            class: "form-input-lg",
            placeholder: "example@mail.com",
            autocomplete: "email",
            required: true %>
    </div>

    <div class="w-100">
      <label for="user_password" class="font-label-lg mb-2 d-block">
        パスワード<span class="required-mark">必須</span>
      </label>
      <%= f.password_field :password,
            class: "form-input-lg",
            autocomplete: "new-password",
            required: true %>
      <p class="form-hint mt-2 mb-0">
        6文字以上24文字以下で決めてください
      </p>
    </div>

    <div class="w-100">
      <label for="user_password_confirmation" class="font-label-lg mb-2 d-block">
        パスワード（もう一度）<span class="required-mark">必須</span>
      </label>
      <%= f.password_field :password_confirmation,
            class: "form-input-lg",
            autocomplete: "new-password",
            required: true %>
      <p class="form-hint mt-2 mb-0">
        確認のため、同じものをもう一度入力してください
      </p>
    </div>

    <div class="w-100">
      <label for="user_age" class="font-label-lg mb-2 d-block">
        年代<span class="optional-mark">任意</span>
      </label>
      <%= f.number_field :age,
            class: "form-input-lg",
            placeholder: "例：65",
            inputmode: "numeric" %>
    </div>

    <%= f.submit "この内容で登録する", class: "btn-primary-wide tactile-press" %>
  <% end %>

  <%= link_to "電話番号で登録する方はこちら", new_login_path, class: "btn-link-plain mt-3" %>
</div>